+ const void *air=native_bridge_metal_variant_hook(f.name.UTF8String,label.UTF8String,pipeline.UTF8String,vertex,&length);
+ if(!air || !length)return f;
+ static NSMutableDictionary *libraries;static std::mutex lock;
+ id library;
+ {std::lock_guard<std::mutex> hold(lock);
+  if(!libraries)libraries=[NSMutableDictionary dictionary];
+  NSNumber *key=@((uintptr_t)air);
+  library=libraries[key];
