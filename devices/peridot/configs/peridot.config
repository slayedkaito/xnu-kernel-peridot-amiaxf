# HakiOS fragment: Xiaomi POCO F6 / Redmi Turbo 3 (peridot, SM8635).
# Board block addresses and pins default in hakios.board.c when /arm-io/device_type == "peridot",
# keeping the kernel command line well within XNU's 607-character limit.
CONFIG_DEVICE="peridot"
CONFIG_FIRMWARE="device"

# Build Peridot drivers; leave out QEMU-only virtio drivers and unported cellular/camera/torch.
CONFIG_HAKIOS_BT=y
CONFIG_HAKIOS_DISPLAY=y
# CONFIG_HAKIOS_VIRTIO_INPUT is not set
# CONFIG_HAKIOS_VIRTIO_BLK is not set
# CONFIG_HAKIOS_VIRTIO_SOUND is not set
# CONFIG_HAKIOS_VIRTIO_NET is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
# CONFIG_HAKIOS_MODEM is not set

# Clear cellular boot-args inherited from common_defconfig while MODEM is left out.
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set

# Runtime Peridot toggles supported by hakios-peridot.
CONFIG_HAPTIC=5
CONFIG_BOOTARGS="touch_no_rpmh=1 small_cores_after=0 adreno_stream1=0 metal=1 thermal=2"
